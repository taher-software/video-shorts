# ─── LLM (au moins une cle requise) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=AI...

# ─── Choix des providers ────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic          # anthropic | openai | google
TTS_PROVIDER=openai             # openai | google
TTS_VOICE=onyx                  # onyx | fable | alloy | echo | nova | shimmer

# ─── Generation ────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
DEFAULT_LANGUAGE=fr
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# ─── Debug ─────────────────────────────────────────────────────────────────────
KEEP_TEMP_FILES=false           # true pour garder les fichiers intermediaires
LOG_LEVEL=INFO
